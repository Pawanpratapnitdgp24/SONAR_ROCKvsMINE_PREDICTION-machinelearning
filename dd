-- PC
SELECT DISTINCT policy_no, claim_no
FROM stage_misreg.STAGE_SRM_PREMIUM_LOSS
WHERE policy_no = '0041000566';

-- YHT
SELECT DISTINCT policy_no, claim_no
FROM stage_misreg.STAGE_SRM_PREMIUM_LOSS
WHERE policy_no = '0041000706';
✅ Goal: Ensure each policy has at least one claim.

2. Check Metadata: Class/CD, LOB, Division, Section, Profit Unit
